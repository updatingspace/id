# Non-secret SMTP settings for iCloud Custom Email Domain.
# Ensure account@updspace.com exists in iCloud before enabling sending.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.me.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL='UpdSpace ID <account@updspace.com>'
# Full PRIMARY iCloud Mail address (usually ...@icloud.com), not the From alias.
EMAIL_HOST_USER=
# Inject the Apple app-specific password from Lockbox or a mounted secret file.
# EMAIL_HOST_PASSWORD=@/run/secrets/icloud-smtp-password
# Public FRONTEND origin, e.g. https://id.updspace.com; no /api/v1 suffix.
# ID_FRONTEND_BASE_URL=https://id.updspace.com
PASSWORD_RESET_TIMEOUT=3600
