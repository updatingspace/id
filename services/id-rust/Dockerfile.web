FROM rust:1.98.1-bookworm AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
RUN --mount=type=cache,id=id-rust-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=id-rust-target,target=/src/target \
    cargo build --locked --release -p id-web \
    && mkdir -p /out \
    && cp /src/target/release/id-web /out/id-web

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY certs/YandexInternalRootCA-*.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates
COPY --from=builder /out/id-web /usr/local/bin/id-web
USER 65532:65532
ENV HOST=0.0.0.0 PORT=8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/id-web"]
