openapi: 3.0.0
info:
  title: updspace-id-gateway
  version: 1.0.0

paths:
  /api/v1/{proxy+}:
    x-yc-apigateway-any-method:
      parameters:
        - name: proxy
          in: path
          required: true
          explode: false
          style: simple
          schema:
            type: string
            default: "-"
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${backend_container_id}
        service_account_id: ${gateway_service_account_id}

%{ if gateway_rust_me && !gateway_use_rust ~}
  /api/v1/auth/me:
    get:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
%{ endif ~}

%{ if gateway_rust_form_token && !gateway_use_rust ~}
  /api/v1/auth/form_token:
    get:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
%{ endif ~}

%{ if gateway_rust_login_api && !gateway_use_rust ~}
  /api/v1/auth/login:
    post:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
    options:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
%{ endif ~}

%{ if gateway_rust_passkey_login && !gateway_use_rust ~}
%{ for action in ["begin", "complete"] ~}
  /api/v1/auth/passkeys/login/${action}:
    post:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
    options:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
%{ endfor ~}
%{ endif ~}

%{ if gateway_rust_passkey_registration && !gateway_use_rust ~}
%{ for action in ["begin", "complete"] ~}
  /api/v1/auth/passkeys/${action}:
    post:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
    options:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
%{ endfor ~}
%{ endif ~}

%{ if gateway_rust_totp_management && !gateway_use_rust ~}
%{ for action in ["begin", "confirm", "disable"] ~}
  /api/v1/auth/mfa/totp/${action}:
    post:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
    options:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
        service_account_id: ${gateway_service_account_id}
%{ endfor ~}
  /api/v1/auth/mfa/recovery/regenerate:
    post:
      x-yc-apigateway-integration:
        type: serverless_containers
        container_id: ${rust_api_container_id}
