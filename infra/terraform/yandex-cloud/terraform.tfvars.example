cloud_id  = "replace-me"
folder_id = "replace-me"

public_domain = "id.updspace.com"
public_zone   = "updspace.com"

# Scale to zero at low traffic. Opt into 1 only with an explicit latency/cost budget.
min_ready_instances = 0

# Rust mail jobs remain disabled until their image digest, SMTP settings,
# migration, rollback and private timer have passed staging acceptance.
# enable_rust_mail_queue      = true # keep enabled during worker rollback
# enable_rust_mail_job        = true
# rust_mail_job_image_tag     = "<tested-commit-sha>"
# rust_mail_job_image_digest  = "sha256:<64 lowercase hex digits>"

# container_registry_id = "crp..." # Use an existing registry for first CI bootstrap.
# certificate_id   = "fpq..."
# manage_dns_zone  = false

lockbox_secret_entries = {
  DJANGO_SECRET_KEY        = "replace-me"
  ID_TOKEN_HASH_SECRET     = "replace-me"
  OIDC_REFRESH_TOKEN_SALT  = "replace-me"
  BFF_INTERNAL_HMAC_SECRET = "replace-me"
  OIDC_PRIVATE_KEY_PEM     = "replace-me"
  OIDC_PUBLIC_KEY_PEM      = "replace-me"
}

# Prefer setting this through CI secret YC_MONIUM_API_KEY.
# monium_api_key = "replace-me"
